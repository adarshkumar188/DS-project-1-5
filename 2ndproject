import numpy as np
import matplotlib.pyplot as plt
import matplotlib.image as mpimg

# Load image
image = mpimg.imread("sample.jpg")

# If image pixels are 0-255 convert to float 0-1
if image.dtype == np.uint8:
    image = image / 255.0

print("Image Shape:", image.shape)

# Convert RGB image to grayscale
# Average of Red, Green, Blue channels

grayscale = np.mean(image[:, :, :3], axis=2)

# Increase brightness
bright_image = np.clip(image + 0.3, 0, 1)

# Decrease brightness
dark_image = np.clip(image - 0.3, 0, 1)

# Flip horizontally
horizontal_flip = np.fliplr(image)

# Flip vertically
vertical_flip = np.flipud(image)

# Crop image
# Format: [rows, columns]

cropped = image[100:400, 100:400]

# Display all images

fig, axes = plt.subplots(2, 4, figsize=(18, 10))

axes[0, 0].imshow(image)
axes[0, 0].set_title("Original")

axes[0, 1].imshow(grayscale, cmap='gray')
axes[0, 1].set_title("Grayscale")

axes[0, 2].imshow(bright_image)
axes[0, 2].set_title("Bright")

axes[0, 3].imshow(dark_image)
axes[0, 3].set_title("Dark")

axes[1, 0].imshow(horizontal_flip)
axes[1, 0].set_title("Horizontal Flip")

axes[1, 1].imshow(vertical_flip)
axes[1, 1].set_title("Vertical Flip")

axes[1, 2].imshow(cropped)
axes[1, 2].set_title("Cropped")

# Hide empty subplot
axes[1, 3].axis('off')

# Remove axis
for ax in axes.ravel():
    ax.axis("off")

plt.tight_layout()
plt.show()
